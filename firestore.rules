rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'chetanaBalance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'photoURL', 'chetanaBalance', 'createdAt', 'updatedAt'])
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.chetanaBalance is number
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['userId', 'role', 'content', 'timestamp', 'createdAt'])
        && data.keys().hasOnly(['userId', 'role', 'content', 'timestamp', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 10000
        && data.timestamp is number
        && data.createdAt is string;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Chat Sessions Collection
    match /chatSessions/{sessionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId)
        && incoming().userId == request.auth.uid
        && isValidChatSession(incoming());
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && isValidChatSession(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      // Messages Subcollection (Master Gate on parent session)
      match /messages/{messageId} {
        allow get, list: if isSignedIn()
          && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(messageId)
          && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid
          && incoming().userId == request.auth.uid
          && isValidMessage(incoming());
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
