{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with Chetana Card balance and settings",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "chetanaBalance": {
          "type": "number"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["displayName", "email", "chetanaBalance", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Conversation sessions with CHETONA",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual messages in a session",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "timestamp": {
          "type": "number"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["userId", "role", "content", "timestamp", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and Chetana Card data"
    },
    "/chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User conversation sessions"
    },
    "/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside each conversation session"
    }
  }
}
